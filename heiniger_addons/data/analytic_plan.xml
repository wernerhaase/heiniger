<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo's project plan is created as noupdate data.  Older databases can
        therefore retain the former "Default" name even though new databases
        call it "Project".  Update the existing record explicitly on every
        Heiniger module upgrade so the analytic distribution selector uses
        the requested label.
    -->
    <record id="analytic.analytic_plan_projects" model="account.analytic.plan" forcecreate="0">
        <field name="name">Project</field>
    </record>
</odoo>
