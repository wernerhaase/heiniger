<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="description_html_move_lineview_form" model="ir.ui.view">
        <field name="name">desc.html.move.line.form</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="widget">text</attribute>

            </xpath>
        </field>
    </record>

    <record id="description_html_move_lineview_list" model="ir.ui.view">
        <field name="name">desc.html.move.line.list</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="widget">text</attribute>

            </xpath>
        </field>
    </record>
    <record id="description_html_move_view_form" model="ir.ui.view">
        <field name="name">desc.html.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='name']" position="attributes">
                <attribute name="widget">text</attribute>
                <attribute name="optional">hide</attribute>
                <attribute name="column_invisible">parent.move_type in ('out_invoice', 'out_refund')</attribute>

            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='name']" position="after">
                <field name="hgr_html_description"
                       string="Description"
                       widget="html"
                       optional="show"
                       column_invisible="parent.move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='name']" position="attributes">
                <attribute name="widget">text</attribute>

            </xpath>


            <xpath expr="//field[@name='line_ids']/list//field[@name='name']" position="attributes">
                <attribute name="widget">text</attribute>

            </xpath>

            <xpath expr="//field[@name='line_ids']/form/group//field[@name='name']" position="attributes">
                <attribute name="widget">text</attribute>

            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='name']" position="after">
                <field name="hgr_html_description" widget="html"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group[1]" position="attributes">
                <attribute name="attrs">{'invisible': [('display_type', 'in', ('line_note', 'line_section'))]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group[2]" position="attributes">
                <attribute name="attrs">{'invisible': [('display_type', 'in', ('line_note', 'line_section'))]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group[3]" position="attributes">
                <attribute name="attrs">{'invisible': [('display_type', 'in', ('line_note', 'line_section'))]}
                </attribute>


            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list" position="attributes">
                <attribute name="editable"></attribute>

            </xpath>
        </field>
    </record>

    <template id="report_invoice_document_html_description" inherit_id="account.report_invoice_document">
        <xpath expr="//td[@name='account_invoice_line_name']/span[@t-field='line.name']" position="replace">
            <span t-if="line.hgr_html_description" t-field="line.hgr_html_description" dir="auto"/>
            <span t-elif="line.name" t-field="line.name" t-options="{'widget': 'text'}" dir="auto">Bacon Burger</span>
        </xpath>
        <xpath expr="//td[@name='line_name_td']/span[@t-field='line.name']" position="replace">
            <span t-if="line.hgr_html_description" t-field="line.hgr_html_description" dir="auto"/>
            <span t-elif="line.name" t-field="line.name" t-options="{'widget': 'text'}" dir="auto">A section title</span>
        </xpath>
        <xpath expr="//t[@t-elif='is_note']/td/span[@t-field='line.name']" position="replace">
            <span t-if="line.hgr_html_description" t-field="line.hgr_html_description" dir="auto"/>
            <span t-elif="line.name" t-field="line.name" t-options="{'widget': 'text'}" dir="auto">A note, whose content usually applies to the section or product above.</span>
        </xpath>
    </template>
</odoo>
