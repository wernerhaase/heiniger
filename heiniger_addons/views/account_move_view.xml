<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hgr_view_move_form_analytic_distribution" model="ir.ui.view">
        <field name="name">account.move.form.analytic.distribution</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="payment_reference" position="after">
                <field name="analytic_distribution"
                       widget="analytic_distribution"
                       groups="analytic.group_analytic_accounting"
                       options="{'business_domain': 'bill', 'amount_field': 'amount_untaxed'}"
                       invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')"
                       readonly="state != 'draft'"/>
            </field>

            <xpath expr="//div[@name='due_date']" position="after">
                <field name="hgr_payment_discount_summary"
                       widget="html"
                       class="text-danger fw-bold"
                       readonly="1"
                       invisible="not hgr_payment_discount_summary"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='analytic_distribution']"
                   position="attributes">
                <attribute name="options">{'product_field': 'product_id', 'account_field': 'account_id', 'amount_field': 'price_subtotal'}</attribute>
            </xpath>

            <xpath expr="//group[hasclass('oe_subtotal_footer')]/field[@name='tax_totals']" position="after">
                <field name="hgr_has_advance_summary" invisible="1"/>
                <div class="d-flex float-end" colspan="2"
                     invisible="not hgr_has_advance_summary">
                    <label for="hgr_sale_order_total"/>
                    <div>
                        <field name="hgr_sale_order_total" widget="monetary"/>
                    </div>
                </div>
                <div class="d-flex float-end" colspan="2"
                     invisible="not hgr_has_advance_summary">
                    <label for="hgr_advance_invoiced_total"/>
                    <div>
                        <field name="hgr_advance_invoiced_total" widget="monetary"/>
                    </div>
                </div>
                <div class="d-flex float-end" colspan="2"
                     invisible="not hgr_has_advance_summary">
                    <label for="hgr_remaining_after_advance"/>
                    <div>
                        <field name="hgr_remaining_after_advance"
                               widget="monetary"
                               class="oe_subtotal_footer_separator"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="hgr_view_in_invoice_tree_discount_due" model="ir.ui.view">
        <field name="name">account.in.invoice.list.discount.due</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_date_due" position="before">
                <field name="invoice_discount_date_due"
                       optional="show"
                       invisible="payment_state in ('paid', 'in_payment', 'reversed') or state == 'cancel'"/>
            </field>
        </field>
    </record>
</odoo>
