<odoo>
    <record id="sale_order_print_attachments" model="ir.ui.view">
        <field name="name">sale.order.print.attachments</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <field name="hgr_print_with_attachments"/>
            </field>
        </field>
    </record>
    <record id="invoice_print_attachments" model="ir.ui.view">
        <field name="name">account.move.print.attachments</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_hgr_refresh_invoice_preview" type="object"
                        string="Refresh invoice preview"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
            </xpath>
            <xpath expr="//div[@name='due_date']" position="after">
                <field name="hgr_print_with_attachments" invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
            </xpath>
        </field>
    </record>
</odoo>
