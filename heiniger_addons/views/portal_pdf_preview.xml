<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_note_pdf_links" inherit_id="sale.sale_order_portal_content">
        <xpath expr="//td[@name='td_section_name_xs']/span[@t-field='line.name']" position="attributes">
            <attribute name="t-field"/>
            <attribute name="t-out">sale_order._hgr_portal_pdf_links(line.name, access_token)</attribute>
        </xpath>
        <xpath expr="//td[@name='td_section_name_sm']/span[@t-field='line.name']" position="attributes">
            <attribute name="t-field"/>
            <attribute name="t-out">sale_order._hgr_portal_pdf_links(line.name, access_token)</attribute>
        </xpath>
        <xpath expr="//td[@name='td_section_name']/span[@t-field='line.name']" position="attributes">
            <attribute name="t-field"/>
            <attribute name="t-out">sale_order._hgr_portal_pdf_links(line.name, access_token)</attribute>
        </xpath>
        <xpath expr="//td[@name='td_note_name']/span[@t-field='line.name']" position="attributes">
            <attribute name="t-field"/>
            <attribute name="t-out">sale_order._hgr_portal_pdf_links(line.name, access_token)</attribute>
        </xpath>
        <xpath expr="//td[@name='td_combo_name']/span[@t-field='line.name']" position="attributes">
            <attribute name="t-field"/>
            <attribute name="t-out">sale_order._hgr_portal_pdf_links(line.name, access_token)</attribute>
        </xpath>
        <xpath expr="//td[@name='td_section_group_name']/span[@t-field='line.name']" position="attributes">
            <attribute name="t-field"/>
            <attribute name="t-out">sale_order._hgr_portal_pdf_links(line.name, access_token)</attribute>
        </xpath>
        <xpath expr="//span[@name='span_product_name']" position="attributes">
            <attribute name="t-field"/>
            <attribute name="t-out">sale_order._hgr_portal_pdf_links(line.name, access_token)</attribute>
        </xpath>
        <xpath expr="//*[@t-field='sale_order.note']" position="attributes">
            <attribute name="t-field"/>
            <attribute name="t-out">sale_order._hgr_portal_pdf_links(sale_order.note, access_token)</attribute>
        </xpath>
    </template>
    <template id="portal_note_pdf_preview" name="Attachment PDF preview">
        <t t-call="portal.portal_layout">
            <div class="container-fluid py-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <h1 class="h5 mb-0 text-break" t-out="attachment.name"/>
                    <a class="btn btn-primary" t-att-href="download_url" download="download">
                        <i class="fa fa-download me-1"/> Download
                    </a>
                </div>
                <iframe t-att-src="inline_url" title="PDF preview" style="width:100%;height:80vh;border:1px solid #ddd;"/>
                <p class="text-muted mt-2">If your browser cannot display the PDF, use Download to open it on your computer.</p>
            </div>
        </t>
    </template>
</odoo>
