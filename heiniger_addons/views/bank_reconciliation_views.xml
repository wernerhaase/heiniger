<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hgr_bank_statement_line_quick_create_tax" model="ir.ui.view">
        <field name="name">account.bank.statement.line.quick.create.tax</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account_accountant.view_bank_statement_line_quick_create_form_bank_rec_widget"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="company_id" invisible="1"/>
                <field name="hgr_tax_count" invisible="1"/>
            </field>
            <xpath expr="//group[hasclass('o_quick_create')]" position="after">
                <div class="px-2 pb-2">
                    <div class="card border-0 bg-light-subtle">
                        <div class="card-body p-2">
                            <label for="hgr_tax_ids" string="Taxes" class="fw-semibold"/>
                            <field name="hgr_tax_ids"
                                   nolabel="1"
                                   widget="many2many_tags"
                                   placeholder="Select one or more taxes"
                                   options="{'no_create': True, 'no_open': True}"
                                   domain="[('company_id', '=', company_id), ('active', '=', True), ('type_tax_use', '=', amount &lt; 0 and 'purchase' or 'sale')]"/>
                            <div invisible="hgr_tax_count &lt; 2" class="mt-2">
                                <div class="text-muted small mb-2">
                                    Allocate the gross transaction amount to each selected tax.
                                </div>
                                <field name="hgr_tax_allocation_ids" nolabel="1">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="company_id" column_invisible="True"/>
                                        <field name="currency_id" column_invisible="True"/>
                                        <field name="tax_id" readonly="1"/>
                                        <field name="amount" sum="Allocated"/>
                                    </list>
                                </field>
                                <div class="d-flex justify-content-end gap-3 mt-2 small">
                                    <span>
                                        <strong>Allocated:</strong>
                                        <field name="hgr_tax_allocation_total" class="oe_inline"/>
                                    </span>
                                    <span>
                                        <strong>Remaining:</strong>
                                        <field name="hgr_tax_allocation_remaining" class="oe_inline"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
